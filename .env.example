# ==========================================
# SheVault Backend Environment Configuration
# ==========================================

PROJECT_NAME="SheVault Safety API"
VERSION="1.0.0"
DEBUG=false

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/shevault
# SQLite (Local Dev): sqlite+aiosqlite:///./shevault.db
DATABASE_URL="sqlite+aiosqlite:///./shevault.db"

# Redis Streams & Cache
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_PIN="5/minute"
RATE_LIMIT_INCIDENT_CREATE="30/minute"

# Ephemeral Data Retention (in days)
RETENTION_LOCATION_DAYS=7
RETENTION_DELIVERY_DAYS=30
RETENTION_INCIDENT_DAYS=365
RETENTION_AUDIT_DAYS=730
